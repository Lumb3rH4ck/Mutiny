[Desktop Entry]
Type=Application
Name=Mutiny
Comment=Malware-aware torrent client with auto-scanning and VPN panic
Exec=@BINDIR@/mutiny -mode tui %U
Icon=mutiny
Terminal=true
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
Categories=Network;FileTransfer;P2P;
Keywords=torrent;p2p;download;vpn;security;
StartupWMClass=Mutiny