[Unit]
Description=Mutiny Torrent Vault
After=network-online.target clamd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mutiny -mode server
WorkingDirectory=%h/Downloads/Mutiny
Restart=on-failure
RestartSec=10
Environment=HOME=%h

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Downloads/Mutiny

[Install]
WantedBy=default.target
