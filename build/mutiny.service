[Unit]
Description=Mutiny Torrent Vault
After=network-online.target clamd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@BINDIR@/mutiny -mode server
WorkingDirectory=%h/Downloads/Mutiny
Restart=on-failure
RestartSec=10
Environment=HOME=%h

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/Downloads/Mutiny %h/.config/mutiny

[Install]
WantedBy=default.target
